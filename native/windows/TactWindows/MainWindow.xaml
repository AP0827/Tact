<Window
    x:Class="TactWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="DashboardView" Visibility="Collapsed">
            <muxc:NavigationView
                x:Name="Nav"
                IsSettingsVisible="True"
                IsBackButtonVisible="Collapsed"
                PaneDisplayMode="Auto"
                SelectionChanged="NavChanged">
                <muxc:NavigationView.PaneHeader>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,8">
                        <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource TactAccentBrush}">
                            <FontIcon Glyph="&#xE945;" Foreground="#09090B" FontSize="18" />
                        </Border>
                        <TextBlock Text="Tact" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </muxc:NavigationView.PaneHeader>
                <muxc:NavigationView.PaneFooter>
                    <StackPanel Margin="8,12" Spacing="4">
                        <TextBlock x:Name="HostLabel" Text="Host" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ConnectionLabel" Text="Disconnected" Foreground="{StaticResource TactAccentBrush}" FontSize="12" />
                    </StackPanel>
                </muxc:NavigationView.PaneFooter>
                <muxc:NavigationView.MenuItems>
                    <muxc:NavigationViewItem Content="System" Tag="System" Icon="Computer" />
                    <muxc:NavigationViewItem Content="Developer" Tag="Developer" Icon="Code" />
                    <muxc:NavigationViewItem Content="Media" Tag="Media" Icon="Audio" />
                    <muxc:NavigationViewItem Content="Events" Tag="Events" Icon="Message" />
                    <muxc:NavigationViewItem Content="Deck" Tag="Deck" Icon="ViewAll" />
                </muxc:NavigationView.MenuItems>

                <Grid Padding="28,18,28,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,22">
                        <TextBlock x:Name="GreetingLabel" Text="Welcome back" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="SubtitleLabel" Text="Your host is ready." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ScrollViewer x:Name="SystemPage" Grid.Row="1">
                        <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
                            <Border Style="{StaticResource PanelCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="14" Background="#2022D3EE"><FontIcon Glyph="&#xE770;" Foreground="{StaticResource TactAccentBrush}" /></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SystemHostName" Text="Tact Host" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock Text="Live desktop telemetry" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                    <Button Grid.Column="2" Content="Lock" Click="LockClicked" />
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Border Style="{StaticResource PanelCardStyle}"><StackPanel Spacing="8"><TextBlock Text="CPU" /><TextBlock x:Name="CpuValue" Text="—" FontSize="28" FontWeight="SemiBold" /><ProgressBar x:Name="CpuProgress" Maximum="100" /></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Memory" /><TextBlock x:Name="MemoryValue" Text="—" FontSize="28" FontWeight="SemiBold" /><ProgressBar x:Name="MemoryProgress" Maximum="100" /></StackPanel></Border>
                                <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Disk" /><TextBlock x:Name="DiskValue" Text="—" FontSize="28" FontWeight="SemiBold" /><ProgressBar x:Name="DiskProgress" Maximum="100" /></StackPanel></Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Battery" /><TextBlock x:Name="BatteryValue" Text="—" FontSize="28" FontWeight="SemiBold" /><ProgressBar x:Name="BatteryProgress" Maximum="100" /></StackPanel></Border>
                            </Grid>
                            <TextBlock Text="Quick controls" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Open terminal" Tag="system.open_terminal" Click="ActionClicked" /><Button Content="Mute" Tag="system.mute" Click="ActionClicked" /><Button Content="Screenshot" Tag="system.screenshot" Click="ActionClicked" /></StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="DeveloperPage" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
                            <TextBlock Text="Repository" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <Border Style="{StaticResource PanelCardStyle}"><StackPanel Spacing="14"><TextBlock x:Name="BranchValue" Text="No repository" FontFamily="Consolas" FontSize="22" /><TextBlock x:Name="GitStatusValue" Text="Waiting for host data" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Stage all" Tag="git.add" Click="ActionClicked" /><Button Content="Pull" Tag="git.pull" Click="ActionClicked" /><Button Content="Push" Tag="git.push" Click="ActionClicked" /></StackPanel></StackPanel></Border>
                            <TextBlock Text="Docker" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ListView x:Name="DockerList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="MediaPage" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                            <Border Width="220" Height="220" CornerRadius="32" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><FontIcon Glyph="&#xE8D6;" FontSize="68" Foreground="{StaticResource TactAccentBrush}" /></Border>
                            <TextBlock x:Name="TrackTitle" Text="Nothing playing" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center" /><TextBlock x:Name="TrackArtist" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center"><Button Content="Previous" Tag="media.previous" Click="ActionClicked" /><Button Content="Play / pause" Tag="media.play_pause" Click="ActionClicked" /><Button Content="Next" Tag="media.next" Click="ActionClicked" /></StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="EventsPage" Grid.Row="1" Visibility="Collapsed">
                        <ListView x:Name="EventsList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,8" MaxWidth="920" HorizontalAlignment="Left"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
                    </Grid>

                    <ScrollViewer x:Name="DeckPage" Grid.Row="1" Visibility="Collapsed">
                        <Grid ColumnSpacing="12" RowSpacing="12" MaxWidth="760" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="140" /><RowDefinition Height="140" /><RowDefinition Height="140" /></Grid.RowDefinitions>
                            <Button Content="VS Code" Tag="vscode.open_workspace" Click="ActionClicked" FontSize="17" /><Button Grid.Column="1" Content="Terminal" Tag="system.open_terminal" Click="ActionClicked" FontSize="17" /><Button Grid.Column="2" Content="Stage all" Tag="git.add" Click="ActionClicked" FontSize="17" />
                            <Button Grid.Row="1" Content="Screenshot" Tag="system.screenshot" Click="ActionClicked" FontSize="17" /><Button Grid.Row="1" Grid.Column="1" Content="Pull" Tag="git.pull" Click="ActionClicked" FontSize="17" /><Button Grid.Row="1" Grid.Column="2" Content="Push" Tag="git.push" Click="ActionClicked" FontSize="17" />
                            <Button Grid.Row="2" Content="Play / pause" Tag="media.play_pause" Click="ActionClicked" FontSize="17" /><Button Grid.Row="2" Grid.Column="1" Content="Mute" Tag="system.mute" Click="ActionClicked" FontSize="17" /><Button Grid.Row="2" Grid.Column="2" Content="Lock" Tag="system.lock_screen" Click="ActionClicked" FontSize="17" />
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="Connection" Style="{ThemeResource SubtitleTextBlockStyle}" /><Border Style="{StaticResource PanelCardStyle}"><StackPanel Spacing="12"><TextBlock x:Name="SettingsHost" FontFamily="Consolas" /><Button Content="Disconnect and forget host" Click="DisconnectClicked" HorizontalAlignment="Left" /></StackPanel></Border><TextBlock Text="Tact for Windows 2.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                    </ScrollViewer>
                </Grid>
            </muxc:NavigationView>
        </Grid>

        <Grid x:Name="PairingView" Padding="28">
            <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Border Width="56" Height="56" CornerRadius="18" Background="{StaticResource TactAccentBrush}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE945;" Foreground="#09090B" FontSize="26" /></Border>
                <TextBlock Text="Tact" Style="{ThemeResource DisplayTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Your computer becomes a live developer control surface." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="17" />
                <TextBox x:Name="HostInput" Header="Computer address" PlaceholderText="192.168.1.42" />
                <PasswordBox x:Name="OtpInput" Header="6-digit pairing code" MaxLength="6" PasswordChar="●" />
                <Button x:Name="PairButton" Content="Pair securely" Click="PairClicked" HorizontalAlignment="Stretch" />
                <ProgressBar x:Name="PairingProgress" IsIndeterminate="True" Visibility="Collapsed" />
                <muxc:InfoBar x:Name="PairingNotice" IsOpen="False" Severity="Informational" IsClosable="True" />
                <TextBlock Text="Pairing stays on your local network. The desktop agent only exposes allowlisted actions." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
