<Window x:Class="TactWindows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="32" Spacing="20" MaxWidth="780" HorizontalAlignment="Center">
    <TextBlock Text="Tact Host" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock x:Name="StatusText" Text="Connecting to the local agent…" Opacity="0.7"/>
    <Border Style="{StaticResource PanelCardStyle}"><StackPanel Spacing="12"><TextBlock Text="THIS HOST" FontWeight="SemiBold" Opacity="0.7"/><TextBlock x:Name="HostText" FontFamily="Consolas" FontSize="18"/><TextBlock Text="PAIRING CODE" FontWeight="SemiBold" Opacity="0.7"/><TextBlock x:Name="OtpText" Text="—" FontFamily="Consolas" FontSize="34" CharacterSpacing="180"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Copy OTP" Click="CopyOtp"/><Button Content="Regenerate OTP" Click="RegenerateOtp"/><Button Content="Refresh" Click="Refresh"/></StackPanel></StackPanel></Border>
    <TextBlock Text="Pending approvals" Style="{ThemeResource SubtitleTextBlockStyle}"/><ListView x:Name="Approvals"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,8"><StackPanel Spacing="8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding DeviceId}" FontFamily="Consolas" Opacity="0.7"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Allow" Tag="{Binding Id}" Click="Approve"/><Button Content="Reject" Tag="{Binding Id}" Click="Reject"/></StackPanel></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
    <TextBlock Text="Authorized controllers" Style="{ThemeResource SubtitleTextBlockStyle}"/><ListView x:Name="Devices"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,8"><StackPanel Orientation="Horizontal" Spacing="12"><StackPanel Width="500"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding LastSeen}" Opacity="0.7"/></StackPanel><Button Content="Terminate" Tag="{Binding Id}" Click="Terminate"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
    <Button Content="Terminate all connections" Click="TerminateAll" HorizontalAlignment="Left"/>
  </StackPanel></ScrollViewer>
</Window>
